{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/kubb.config.ts",
			"**/app.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/~sdk",
			"!**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"formatWithErrors": false
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[
								":NODE:"
							],
							":BLANK_LINE:",
							[
								":PACKAGE:",
								"!@turystack/**",
								"!@repo/**"
							],
							":BLANK_LINE:",
							[
								"@turystack/**"
							],
							":BLANK_LINE:",
							[
								"@repo/**"
							],
							":BLANK_LINE:",
							[
								"#/**"
							],
							":BLANK_LINE:",
							[
								":PATH:"
							]
						]
					}
				},
				"useSortedAttributes": {
					"level": "on",
					"options": {}
				},
				"useSortedKeys": {
					"level": "on",
					"options": {}
				},
				"useSortedProperties": {
					"level": "on",
					"options": {}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": {
					"fix": "safe",
					"level": "error",
					"options": {
						"attributes": [
							"className"
						],
						"functions": [
							"tv"
						]
					}
				}
			},
			"style": {
				"useBlockStatements": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": [
							"warn",
							"error"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"attributePosition": "multiline",
			"trailingCommas": "all",
			"expand": "always"
		}
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"overrides": [
		{
			"includes": [
				"**/src/features/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/routes/**",
											"#/routes/**"
										],
										"message": "COM-3 / RTE-1: a component never reads the router — it receives props and emits callbacks."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/src/routes/**",
				"**/src/app/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features/*/components/**",
											"@/features/*/support/**"
										],
										"message": "STR-2 / ARC-LAY-5: import the feature's barrel, never its internals."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/src/ui/**",
				"**/src/components/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/~sdk/**",
											"#/~sdk/**",
											"@/features/**",
											"@/routes/**"
										],
										"message": "CPS-5: a primitive is domain-agnostic — no SDK, feature or route import."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/*.json"
			],
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": {
							"level": "off",
							"options": {}
						},
						"useSortedProperties": {
							"level": "off",
							"options": {}
						}
					}
				}
			}
		}
	],
	"plugins": [
		"./plugins/no-as-prop.grit",
		"./plugins/no-classname-prop.grit",
		"./plugins/no-conditional-class.grit",
		"./plugins/no-data-fallback.grit",
		"./plugins/no-default-export.grit",
		"./plugins/no-external-class-merge.grit",
		"./plugins/no-hardcoded-brand.grit",
		"./plugins/no-icon-name-prop.grit",
		"./plugins/no-implementation-query.grit",
		"./plugins/no-inline-handler.grit",
		"./plugins/no-inline-permission-check.grit",
		"./plugins/no-inline-union.grit",
		"./plugins/no-layout-scaled-media.grit",
		"./plugins/no-literal-visual-value.grit",
		"./plugins/no-manual-focus.grit",
		"./plugins/no-navigable-state-in-memory.grit",
		"./plugins/no-navigate-in-form.grit",
		"./plugins/no-outline-none.grit",
		"./plugins/no-raw-breakpoint.grit",
		"./plugins/no-raw-interactive.grit",
		"./plugins/no-redundant-fallback.grit",
		"./plugins/no-reset-effect.grit",
		"./plugins/no-rewrite-api-message.grit",
		"./plugins/no-route-loader-data.grit",
		"./plugins/no-scheme-branch.grit",
		"./plugins/no-selected-row-state.grit",
		"./plugins/no-server-state-copy.grit",
		"./plugins/no-synthetic-event.grit",
		"./plugins/no-unsafe-output.grit",
		"./plugins/onchange-delivers-value.grit",
		"./plugins/optimistic-write-shape.grit"
	]
}
